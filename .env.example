# Copy this file to .env and edit. Everything is optional:
# ShieldIQ runs fully offline with no keys at all.

# --- Core -------------------------------------------------------------------
# Left empty, both secrets are generated once and stored in instance/ (git-ignored).
SHIELDIQ_SECRET_KEY=
# Fernet key, create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHIELDIQ_ENCRYPTION_KEY=

SHIELDIQ_HOST=127.0.0.1
SHIELDIQ_PORT=5000
# Create the demo workspace (demo@shieldiq.local, fictional data, PUBLIC demo password) on first run.
# Off by default. Set to 1 only for a local/portfolio demo - never on an internet-facing deployment.
SHIELDIQ_SEED_DEMO=0
# AWS CLI profiles that live AWS integrations may name (comma-separated). Empty = disabled (recommended):
# integrations must bring their own read-only access key, never the server's credentials.
SHIELDIQ_ALLOWED_AWS_PROFILES=
# Set to 1 only when serving over HTTPS
SHIELDIQ_SECURE_COOKIES=0
# Default is SQLite in instance/shieldiq.db; any SQLAlchemy URL works
# DATABASE_URL=postgresql://user:pass@localhost/shieldiq

# --- Security Copilot (optional) -------------------------------------------
# Any OpenAI-compatible chat API. Without a key, or if the call fails,
# the built-in offline engine answers instead.
SHIELDIQ_LLM_API_KEY=
SHIELDIQ_LLM_BASE_URL=https://api.openai.com/v1
SHIELDIQ_LLM_MODEL=gpt-4o-mini

# --- GitHub (optional) ------------------------------------------------------
# Raises the API rate limit for live scans and is the default token for fix PRs.
GITHUB_TOKEN=

# --- Alert delivery (optional) ----------------------------------------------
SHIELDIQ_SLACK_WEBHOOK_URL=
SHIELDIQ_SMTP_HOST=
SHIELDIQ_SMTP_PORT=587
SHIELDIQ_SMTP_USER=
SHIELDIQ_SMTP_PASSWORD=
SHIELDIQ_SMTP_FROM=
